<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/StyleSheet.uss?fileID=7433441132597879392&amp;guid=e89882fce1ecee24ea6ee6cde210e3d0&amp;type=3#StyleSheet" />
    <ui:VisualElement name="HudRoot" />
    <ui:VisualElement name="PausePanel" class="pause-panel" style="display: none; position: relative; bottom: 3px; width: 1920px; height: 1080px; background-image: url(&quot;project://database/Assets/Pictures/forest_spooky.jpg?fileID=2800000&amp;guid=34288929bf8fdb449a29f3b895c6d92f&amp;type=3#forest_spooky&quot;);">
        <ui:VisualElement name="pause-overlay" class="pause-overlay" style="bottom: 100%; right: 100%; display: flex; background-image: url(&quot;project://database/Assets/Pictures/forest_spooky.jpg?fileID=2800000&amp;guid=34288929bf8fdb449a29f3b895c6d92f&amp;type=3#forest_spooky&quot;); -unity-background-scale-mode: stretch-to-fill;" />
        <ui:VisualElement name="pause-container" class="pause-container" style="top: 372px; left: 0; position: relative; height: 461px; flex-shrink: 1; background-color: rgba(56, 56, 56, 0);">
            <ui:Label text="Paused" class="pause-title" style="color: rgb(255, 172, 0); font-size: 64px; -unity-font-style: bold;" />
            <ui:Button name="ResumeButton" text="Resume" class="button menu-button" style="height: 80px; width: 600px; margin-top: 20px; margin-bottom: 20px;" />
            <ui:Button name="OptionsButton" text="Options" class="button menu-button" style="margin-top: 20px; margin-bottom: 20px;" />
            <ui:Button name="QuitButton" text="Quit to Menu" class="button menu-button" style="margin-top: 20px; margin-bottom: 20px;" />
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="EndScreen" style="flex-grow: 1; background-color: rgb(133, 229, 216); background-image: url(&quot;project://database/Assets/Pictures/forest_spooky.jpg?fileID=2800000&amp;guid=34288929bf8fdb449a29f3b895c6d92f&amp;type=3#forest_spooky&quot;); display: none;">
        <ui:Label tabindex="-1" text="It was all a dream..." parse-escape-sequences="true" display-tooltip-when-elided="true" name="Label" style="color: rgb(255, 178, 0); font-size: 60px; position: absolute; top: 507px; left: 626px; width: 785px; align-items: center; align-self: center; justify-content: center; flex-direction: row; -unity-font-style: bold-and-italic; -unity-text-align: upper-center; height: 102px; background-color: rgba(0, 0, 0, 0.5);" />
        <ui:Label tabindex="-1" text="Thank you for playing! - Daya &lt;3" parse-escape-sequences="true" display-tooltip-when-elided="true" style="color: rgb(255, 178, 0); font-size: 42px; position: absolute; top: 990px; left: 6px; width: 785px; align-items: center; align-self: center; justify-content: center; flex-direction: row; -unity-font-style: bold-and-italic; -unity-text-align: upper-center; height: 102px;" />
        <ui:Label tabindex="-1" text="You Woke Up!" parse-escape-sequences="true" display-tooltip-when-elided="true" name="Label" style="color: rgb(255, 178, 0); font-size: 72px; position: absolute; top: 399px; left: 620px; width: 785px; align-items: center; align-self: center; justify-content: center; flex-direction: row; -unity-font-style: bold; -unity-text-align: upper-center; height: 102px; background-color: rgba(0, 0, 0, 0.5);" />
    </ui:VisualElement>
    <ui:VisualElement name="death-panel" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0.74); display: none;">
        <ui:Label tabindex="-1" text="You Died!" parse-escape-sequences="true" display-tooltip-when-elided="true" name="death-title" style="font-size: 150px; color: rgb(255, 255, 255); -unity-font-style: bold; left: 0; -unity-text-align: upper-center; top: 25%;" />
        <ui:Button text="Respawn" parse-escape-sequences="true" display-tooltip-when-elided="true" name="respawn-button" class="menu-button" style="align-self: center; top: 35%;" />
        <ui:Button text="Main Menu" parse-escape-sequences="true" display-tooltip-when-elided="true" name="mainmenu-button" class="menu-button" style="align-self: center; top: 45%;" />
    </ui:VisualElement>
</ui:UXML>
