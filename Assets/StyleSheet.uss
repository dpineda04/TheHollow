.menu-button {
    width: 600px;
  height: 80px;

  /* ensure no image hides the color */
  
  /* valid color */
  background-color: rgb(255, 230, 179);

  /* border must have width, style, and color (color must be a Color, not a keyword) */
  border-width: 6px;
  border-style: solid;
  border-color: rgb(60, 33, 1);

  /* rounded corners (shorthand) */
  border-radius: 10px;

  /* font & text */
  -unity-font: url("project://database/Assets/TextMesh%20Pro/Fonts/LiberationSans.ttf?fileID=12800000&guid=e3265ab4bf004d28a9537516768c1c75&type=3#LiberationSans");
  font-size: 32px;
  -unity-font-style: bold;
  color: rgb(60, 33, 1);
  -unity-text-align: middle-center;

  /* layout */
  display: flex;
  align-items: center;
  justify-content: center;
}

.menu-background {
  position: absolute;
  left: 0; right: 0; top: 0; bottom: 0;
  background-image: url("Pictures/forest_spooky.jpg");
  background-size: cover;
  background-position: center;
  opacity: 1;
}
